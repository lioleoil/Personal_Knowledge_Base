      "model": "claude-haiku-4-5-20251001",
      "provider": "anthropic",
      "temperature": 0.3,
      "max_tokens": 1024,
      "_comment": "사용자 대화 창구 — 경량 모델로 비용 최소화"
    },
    "execution": {
      "model": "claude-sonnet-4-5",
      "provider": "anthropic",
      "temperature": 0.3,
      "max_tokens": 8192,
      "_model_alt": "claude-haiku-4-5-20251001",
      "_comment": "복잡한 작업 분해. Haiku 전환 시 _model_alt 값을 model에 복사"
    },
    "validation": {
      "model": "claude-opus-4-7",
      "provider": "anthropic",
      "temperature": 0.1,
      "max_tokens": 1024,
      "_comment": "규칙 기반 판정 — 낮은 temperature로 일관성 확보"
    },
    "advisor": {
      "model": "claude-opus-4-7",
      "provider": "anthropic",
      "temperature": 0.2,
      "max_tokens": 4096,
      "_comment": "심층 근본 원인 분석 — 낮은 temperature로 논리 일관성"
    },
    "reporter": {
      "model": "claude-haiku-4-5-20251001",
      "provider": "anthropic",
      "temperature": 0.5,
      "max_tokens": 2048,
      "_comment": "서식화 보고서 — Haiku로 비용 절감"
    }
  },

  "domain_presets": {
    "_comment": "도메인별 프리셋. 'default'이면 agents 블록 사용.",
