{
  "schema_version": "2.0",
  "updated_at": "2026-04-11",
  "description": "Advisor 에이전트 자동 승인 레지스트리. 이 파일이 모든 에이전트 권한 판단의 기준이 된다.",
  "auto_approved": {
    "file_read":    { "granted": true, "scope": "any" },
    "file_write":   { "granted": true, "scope": "project_root" },
    "file_edit":    { "granted": true, "scope": "project_root" },
    "bash_execute": { "granted": true, "scope": "non_destructive" },
    "bash_python":  { "granted": true, "scope": "non_destructive" },
    "bash_run":     { "granted": true, "scope": "non_destructive" },
    "web_fetch":    { "granted": true, "scope": "read_only" },
    "web_search":   { "granted": true, "scope": "read_only" },
    "git_commit":   { "granted": true, "scope": "local" },
    "git_push":     { "granted": true, "scope": "feature_branch" },
    "git_branch":   { "granted": true, "scope": "local" },
    "git_fetch":    { "granted": true, "scope": "any" },
    "git_pull":     { "granted": true, "scope": "any" },
    "glob_search":  { "granted": true, "scope": "any" },
    "grep_search":  { "granted": true, "scope": "any" },
    "agent_spawn":  { "granted": true, "scope": "ecosystem_agents_only" }
  },
  "user_approval_required": {
    "file_delete":        { "granted": false, "reason": "파일 삭제는 되돌릴 수 없음 — 항상 사용자 확인 필요" },
    "git_force_push":     { "granted": false, "reason": "원격 히스토리 파괴 위험" },
    "external_api_write": { "granted": false, "reason": "외부 시스템 부작용 발생 가능" }
  },
  "advisor_override_policy": {
    "can_grant_new_permissions": false,
    "can_approve_from_auto_approved": true,
    "escalate_if_not_in_registry": true
  },
  "notes": "user_approval_required 항목은 Advisor가 단독으로 승인 불가. 반드시 사용자 에스컬레이션 후 nova_helper Slack 알림 발송."
}
